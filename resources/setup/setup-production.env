# ----------------------------------------
# APPLICATION ARCHITECTURE & CONTEXT
# ----------------------------------------
APP_NAME="Mercy Scaffold"

# APP_VERSION will be generated
APP_VERSION=

# Service name (docker contrainer). Must match the hardcoded service key in compose.yaml
APP_SERVICE=mercy.app

# APP_INSTANCE_KEY short unique sanitize key is used to prevent collision between projects.
# Will set by install script once to name docker containers.
# Do not change this ever after install.
APP_INSTANCE_KEY=
# APP_KEY also wil set once on install
APP_KEY=
APP_ENV=production
APP_LOCALE=de
REDIS_PREFIX="mercy_redis_${APP_INSTANCE_KEY}_"
CACHE_PREFIX="mercy_cache_${APP_INSTANCE_KEY}_"
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_DOMAIN="mercy.intranet.my-domain.de"
APP_URL="https://${APP_DOMAIN}"
APP_IP="127.0.0.1"

FORCE_HTTPS=false
CONFIG_CACHE=false

LOG_CHANNEL=stack
LOG_MAX_FILES=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=daily,stderr

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=mercy_scaffold_db
DB_USERNAME=mercy_user
DB_PASSWORD=mercy_password

BROADCAST_DRIVER=reverb
BROADCAST_CHANNEL_PREFIX="${APP_ENV}.${APP_NAME}."
BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="my-email@local.test"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_BACKUP_TO="backup@local.test"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_KEY=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER="eu"

SCHEDULE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MODULE_DEPLOYENV_MAKE_MODULE_AUTHOR_NAME="John Doe"
MODULE_DEPLOYENV_MAKE_MODULE_AUTHOR_EMAIL="john.doe@localhost.test"
MODULE_DEPLOYENV_MAKE_MODULE_COMPOSER_VENDOR_NAME="john-doe-laravel"
MODULE_DEPLOYENV_REQUIRE_MODULES_DEFAULT_VENDOR="aklebe-laravel"
MODULE_DEPLOYENV_REQUIRE_MODULES_GIT=""
MODULE_DEPLOYENV_REQUIRE_MODULES_STRATEGY="DEFAULT"

# ----------------------------------------
# MODULES SECTION
# ----------------------------------------
# SystemBase Caches.
# This cache settings will only work with SystenBase Cache.
# It's not for global redis cache.
# 0 = no chache!
MODULE_SYSTEM_BASE_CACHE_ENABLED=true
# default TTL for any cache ttl was not set
MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL=2
# Default LOW: dev 1, prod 5
MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_LOW=5
# Default LOW: dev 5, prod 3600
MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_BIG=30
# Cache for SystemBase Config only
MODULE_SYSTEM_BASE_CACHE_CORE_CONFIG_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_LOW}"
# Cache for db tables, columns, extra attributes ...
MODULE_SYSTEM_BASE_CACHE_DB_SIGNATURE_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_BIG}"
# Cache for class names and properties
MODULE_SYSTEM_BASE_CACHE_OBJECT_SIGNATURE_TTL=0
# cache for object value/content
MODULE_SYSTEM_BASE_CACHE_OBJECT_INSTANCE_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_LOW}"
# Cache for frontend
MODULE_SYSTEM_BASE_CACHE_FRONTEND_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_BIG}"
# Cache for translations
MODULE_SYSTEM_BASE_CACHE_TRANSLATIONS_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_BIG}"
# Cache for db to model extra attributes ...
MODULE_WEBSITEBASE_CACHE_EXTRA_ATTRIBUTE_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_BIG}"
# Cache for db to model extra attributes. Entities per type assignment table like "model_attribure_assignment_[type]"
MODULE_WEBSITEBASE_CACHE_EXTRA_ATTRIBUTE_ENTITY_TTL="${MODULE_SYSTEM_BASE_CACHE_DEFAULT_TTL_LOW}"

# ----------------------------------------
# TELEGRAM SECTION
# ----------------------------------------
TELEGRAM_BOTS_UPDATE_CACHE_TTL=3600
#TELEGRAM_BOT_TOKEN=""#needed by sdk
TELEGRAM_BOT_NAME_LOCAL_DEV1=""
TELEGRAM_BOT_TOKEN_LOCAL_DEV1=""
TELEGRAM_BOT_NAME_LOCAL_DEV2=""
TELEGRAM_BOT_TOKEN_LOCAL_DEV2=""
#TELEGRAM_BOT_NAME_PROD=""
#TELEGRAM_BOT_TOKEN_PROD=""
#TELEGRAM_BOT_NAME_DEV=""
#TELEGRAM_BOT_TOKEN_DEV=""
#TELEGRAM_BOT_NAME_INT=""
#TELEGRAM_BOT_TOKEN_INT=""

TELEGRAM_CERTIFICATE_PATH=""
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_ASYNC_REQUESTS=false

# ----------------------------------------
# DOCKER SPECIFIC SECTION
# ----------------------------------------
# docker image location
DOCKER_REGISTRY_IMAGE=
# Preventing collisions between containers even when build same projects.
COMPOSE_PROJECT_NAME="mercy_${APP_INSTANCE_KEY}"
# Ports: To be safe use values between 1024 to 32767
# (Default 80)
APP_PORT=
# DB (Default 3306)
FORWARD_DB_PORT=
# Redis (Default 6379)
FORWARD_REDIS_PORT=
# MailPit (Default 1025 & 8025)
FORWARD_MAILPIT_PORT=
FORWARD_MAILPIT_DASHBOARD_PORT=
# Vite (Default 5173)
VITE_PORT=

WWWGROUP=1000
WWWUSER=1000

# ----------------------------------------
# REVERB SECTION
# ----------------------------------------
REVERB_HOST="reverb-${APP_DOMAIN}"
REVERB_SCHEME=https
REVERB_PORT=443
REVERB_SERVER_PORT=
REVERB_APP_ID="mercy-reverb-app-${APP_INSTANCE_KEY}"
REVERB_APP_KEY="key-${APP_INSTANCE_KEY}"
REVERB_APP_SECRET="secret-${APP_INSTANCE_KEY}"
REVERB_SERVER_HOST=0.0.0.0
# (default 10000), 64-128kb for mid size
REVERB_MAX_REQUEST_SIZE=10000
# (default 10000)
REVERB_APP_MAX_MESSAGE_SIZE=10000

# ----------------------------------------
# VITE SECTION
# ----------------------------------------
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----------------------------------------
# LDAP SECTION
# ----------------------------------------
# Enable/Disable LDAP
LDAP_ENABLED=false

# Enable/Disable Caching
LDAP_CACHE=false

# Enable/Disable Logging
LDAP_LOGGING=true

# name of current config ldap.connections
LDAP_CONNECTION=default

# activate certificate
LDAP_OPT_X_TLS_REQUIRE_CERT=false

# ldap server host
LDAP_HOST="ldap.example.com"

# ldap server port
LDAP_PORT=389

# connection timeout in seconds
LDAP_TIMEOUT=5

# connection handshake timeout in seconds
LDAP_CONNECT_TIMEOUT=5

# Enable/Disable SSL
LDAP_SSL=true

# Enable/Disable TLS
LDAP_TLS=false

# user search filter
LDAP_USERNAME="cn=ldap-search-user,ou=users,dc=ldap,dc=my-server-1"

# ldap secret
LDAP_PASSWORD="xyz123"

# Base Bind
LDAP_BASE_DN="dc=ldap,dc=my-server-1"

# 'cn', 'uid', 'sAMAccountName', ...
LDAP_GUID_AUTH_NAME="cn"

# Users allowed only by this grous (like "Members,Admins")
LDAP_USERS_ALLOWED_FROM_GROUPS="Members"

# Import/Sync by cron every 4 hours
LDAP_IMPORT_CRON="25 */4 * * *"

# Name of ldap group class
LDAP_OBJECT_CLASS_GROUPS="posixGroup"

# Name of ldap user/person class
LDAP_OBJECT_CLASS_USERS="posixAccount"

# ----------------------------------------
# THEME SECTION
# ----------------------------------------
THEME_FRAMEWORK="tailwind"
THEME_NAME="mercy-blank"
THEMER_SYMLINK=false
TALLSTACKUI_ICON_TYPE="heroicons"
TALLSTACKUI_DARK_THEME_DEFAULT="dark"

# ----------------------------------------
# NPM SECTION (Nginx Proxy Manager)
# ----------------------------------------
NPM_API_URL="http://localhost:81/api"
NPM_API_USER="admin@example.com"
NPM_API_PASSWORD="changeme"
