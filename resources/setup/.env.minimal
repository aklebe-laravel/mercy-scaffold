# =============================================
# This env is used for install/build processes
# to minimal config to start artisan.
# =============================================
# Service name (docker contrainer). Must match the hardcoded service key in compose.yaml
APP_SERVICE=mercy.app
APP_ENV=minimal
APP_KEY="base64:ABC123456789" # just a dummy key
CACHE_STORE=array
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
THEME_NAME="mercy-blank"
