{
    "name": "aklebe-laravel/mercy-scaffold",
    "type": "project",
    "description": "Mercy Application Scaffold",
    "keywords": [
        "framework",
        "laravel",
        "Scaffold",
        "Boilerplate"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/aklebe-laravel/mercy-php-deployment.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "aklebe-laravel/mercy-php-deployment": "^2.1",
        "alizharb/laravel-themer": "^1.4",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "blade-ui-kit/blade-icons": "^1.9",
        "composer/semver": "^3.4",
        "directorytree/ldaprecord-laravel": "^4.0",
        "intervention/image": "^4.3",
        "laravel/framework": "^13.32",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.7",
        "laravel/tinker": "^v3.0",
        "livewire/livewire": "^v4.4",
        "nwidart/laravel-modules": "^13.0",
        "opcodesio/log-viewer": "^3.0",
        "predis/predis": "^3.0",
        "pusher/pusher-php-server": "^7.0",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-navigation": "^1.3",
        "tallstackui/tallstackui": "^4.1",
        "technikermathe/blade-lucide-icons": "^3.181",
        "wikimedia/composer-merge-plugin": "^2.1",
        "ext-zip": "*"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "brianium/paratest": "^7.24",
        "fakerphp/faker": "^v1.24",
        "laravel/breeze": "^2.4",
        "laravel/dusk": "^8.6",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.67",
        "laravel/ui": "^v4.6",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php bootstrap/artisan-if-ready.php package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php bootstrap/artisan-if-ready.php vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "composer.app.json",
                "composer.local.json",
                "Modules/*/composer.json",
                "themes/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": false
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "aklebe-laravel/*": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
